{{!--
  Item Card Layout - Matches original row-talent-augment.hbs structure
  
  Context expects:
  - item: The item data object
  - layout: { left: Field[], center: Field[], right: Field[], containerClass: string, containerData: object }
  
  Usage:
  {{> shared/partials/item-card item=item layout=cardLayout}}
--}}
<div class="{{layout.containerClass}} avant-item-card{{#if (eq item.type "weapon")}} weapon-action{{/if}}{{#if (eq item.type "armor")}} armor-action{{/if}}{{#if (eq item.type "gear")}} gear-action{{/if}}"
     {{#each layout.containerData}}{{@key}}="{{this}}"{{/each}}
     role="group"
     aria-roledescription="item card"
     aria-labelledby="item-card-title-{{item._id}}">
  
  {{!-- Left Column: Chat/Roll Control (matches row-control) --}}
  <div class="row-control action-buttons">
    {{#each layout.left}}
      {{> "systems/avant/templates/shared/partials/render-field" field=this editable=true}}
    {{/each}}
  </div>
  
  {{!-- Middle Column: Main content (matches row-content) --}}
  <div class="row-content action-content">
    {{#each layout.center}}
      {{> "systems/avant/templates/shared/partials/render-field" field=this editable=true}}
    {{/each}}
  </div>
  
  {{!-- Right Column: Edit/Delete (matches row-actions) --}}
  <div class="row-actions action-controls">
    {{#each layout.right}}
      {{> "systems/avant/templates/shared/partials/render-field" field=this editable=true}}
    {{/each}}
  </div>
  
</div>